PORT=8787
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=
# Server-only secret: never use a NEXT_PUBLIC_ or EXPO_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REST_ONLY=true
# Optional direct database transport; REST-only mode is recommended here.
DATABASE_URL=
# Optional PEM CA certificate if your direct database endpoint requires one.
PG_CA_CERT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+YOUR_NUMBER
# Exact public HTTPS URL configured in Twilio, including any query string.
TWILIO_WEBHOOK_URL=https://YOUR_HOST/webhooks/twilio/whatsapp
# Simulator is off by default. If enabled, enter this token in its browser page.
ENABLE_SIMULATOR=false
SIMULATOR_TOKEN=
